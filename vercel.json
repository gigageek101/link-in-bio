{
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "/robots.txt",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/meta-safe.txt",
      "dest": "/meta-safe.txt",
      "headers": {
        "Content-Type": "text/plain",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/terms",
      "dest": "/terms.html",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/redirect",
      "dest": "/api/safe-redirect.js"
    },
    {
      "src": "/api/analytics",
      "dest": "/api/analytics-safe.js"
    },
    {
      "src": "/(.*\\.(css|js|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot))",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/allisonsundress.html",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}
